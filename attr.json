    "source": "class SumEqualsProduct(Exercise):\n\n    def preamble(self):\n        return r'You know that $2 + 2 = 2 \\times 2$.'\n\n    def problem(self):\n        return Problem(\n            '''\n            Find a set of three different integers whose sum is equal to their\n            product.\n\n            <<numbers>>\n            ''',\n            numbers=Set(count=3)\n        )\n\n    def a_solution(self):\n        return {1, 2, 3}\n\n    def scores(self, numbers):\n        return sum(numbers) == math.prod(numbers)\n",
